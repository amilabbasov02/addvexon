# ============================================================
# Addvoxen — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ============================================================

# ---------- Core ----------
DATABASE_URL=postgres://user:password@host/db
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=addvoxen.com

# ---------- OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Billing ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
LEMON_API_KEY=
LEMON_STORE_ID=
LEMON_WEBHOOK_SECRET=

# ---------- Storage (Cloudflare R2) ----------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# ---------- AI ----------
ANTHROPIC_API_KEY=

# ---------- Transactional email (existing, Resend) ----------
RESEND_API_KEY=
EMAIL_FROM="Addvoxen <noreply@addvoxen.com>"
SUPPORT_EMAIL=

# ---------- Admin ----------
ADMIN_EMAILS=

# ============================================================
# LEAD FINDER
# ============================================================

# Shared secret for the background job cron endpoint.
# Vercel Cron sends this automatically once it is set in project settings;
# locally you can advance the queue with:
#   curl -H "Authorization: Bearer $CRON_SECRET" localhost:3000/api/cron/jobs
CRON_SECRET=

# Overpass (OpenStreetMap) endpoint. The public instance is fine for low
# volume; point this at your own instance if you ever need throughput.
# Data is ODbL — attribution is stored on every lead and shown in the UI.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ---------- Stock imagery for generated demos ----------
# A demo with no photographs looks unfinished, and an unfinished demo does not
# sell. Set ONE of these; whichever is present is used. Both licences permit
# commercial use, which matters because these images ship on a paid site.
# With neither set, demos build without imagery and fall back cleanly.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ---------- Outreach email (Hetzner SMTP) ----------
# NEVER hardcode these. Read only on the server; no client component imports them.
# Kept separate from RESEND_API_KEY on purpose: cold outreach must not share a
# sending identity with transactional mail, or one spam complaint takes both down.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Addvoxen <info@addvoxen.com>"

# Signs the opt-out links in outreach emails. Falls back to BETTER_AUTH_SECRET
# if unset, but set it explicitly — rotating your auth secret would otherwise
# break every unsubscribe link already sitting in someone's inbox.
OUTREACH_UNSUBSCRIBE_SECRET=

# ---------- Reply tracking (Phase 4 — IMAP) ----------
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
